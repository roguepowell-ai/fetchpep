#!/bin/sh
# Finds bash and runs the real hook, .githooks/pre-push.bash (O-71).
#
# GitHub Desktop's bundled git has sh but no bash, so a hook that starts
# "#!/usr/bin/env bash" fails there before any check runs. This shim is POSIX sh, which
# every git on Windows can run. It never skips the checks: if no bash is found, the push is
# refused, not waved through.
#
# stdin (the refs being pushed) and the arguments pass straight through to the real hook.
# Shell built-ins only, so the refusal still prints on a PATH with no tools on it.

hook="${0%/*}/pre-push.bash"

for b in \
  "$(command -v bash 2>/dev/null)" \
  "/c/Program Files/Git/bin/bash.exe" \
  "/c/Program Files/Git/usr/bin/bash.exe"
do
  if [ -n "$b" ] && [ -x "$b" ]; then
    exec "$b" "$hook" "$@"
  fi
done

printf '%s\n' \
  "pre-push: no bash found, so the contract checks cannot run. Push refused." \
  "" \
  "Install Git for Windows (it provides C:\\Program Files\\Git\\bin\\bash.exe), or push from a" \
  "shell that has bash on PATH. Skipping the checks is not the fix (O-71)." >&2
exit 1
