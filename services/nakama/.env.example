# Key names with empty values. Never values (R-SEC-01).
#
# Copy to `.env` for a local run and fill it from a password manager or from `openssl rand`.
# On the VM there is no `.env` by hand: the startup script reads the same four names out of
# Secret Manager at boot and writes the file with mode 0600 (infra/dev/secrets.tf).
#
# `.env` and `nakama.runtime.yml` are both in .gitignore. Neither is ever committed.
#
# Every value must match ^[A-Za-z0-9_-]+$ — see the header of render-config.sh for why.
# Generate one with:  openssl rand -base64 33 | tr '+/' '-_'

NAKAMA_DB_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_PASSWORD=
