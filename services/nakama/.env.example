# Key names with empty values. Never values (R-SEC-01, D-089).
#
# Copy to `.env` for a local run and fill it from a password manager or from `openssl`.
# On the VM there is no `.env` by hand: the startup script reads these names out of Secret
# Manager at boot and writes the file with mode 0600 (infra/dev/secrets.tf).
#
# `.env` and `nakama.runtime.yml` are both in .gitignore. Neither is ever committed.
#
# Every value must match ^[A-Za-z0-9_-]+$ — see the header of render-config.sh for why.
# Generate one with:  openssl rand -base64 33 | tr -d '\n' | tr '+/' '-_'

NAKAMA_DB_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_PASSWORD=

# Nakama has published defaults for these three. Unset, anyone who reaches the port can
# forge a player session or an admin console token without knowing any password.
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=
NAKAMA_CONSOLE_SIGNING_KEY=

# Shared with the website when there is one (D-080, D-090, O-77). Nothing in the container
# reads it yet; it is fetched at boot so that a missing version is found then, and not on
# the day the first invite is sent.
INVITE_EMAIL_HMAC_KEY=

# Local runs only. On the VM the startup script sets this to the database disk; left unset,
# compose uses the named volume `pgdata`.
PGDATA_PATH=
